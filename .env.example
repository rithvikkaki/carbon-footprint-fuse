# Carbon Footprint Fuse - Environment Configuration Template
# Copy this file to .env and adjust credentials for your environment

# Environment Mode (development | production)
ENVIRONMENT=development

# Database Configuration (PostgreSQL 16 / Neon / Supabase)
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5432/ecofuse

# JWT Authentication (In production, must be at least 32 characters)
SECRET_KEY=replace_with_a_secure_random_string_for_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated or * for public APIs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_MARKETPLACE=30

# API Settings
PROJECT_NAME="Carbon Footprint Fuse API"
VERSION=1.0.0

# Frontend Environment Variable (Set in Vercel / Cloudflare Pages)
# VITE_API_URL=https://your-backend.onrender.com/api/v1
